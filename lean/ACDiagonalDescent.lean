/-- The zero parameter has a direct 15-primitive finish. -/
theorem base : Steps (diagonal 0) 15 (standard 2) := by
  have hi : diagonal 0 = pair (x * x * y⁻¹) (x) := by
    ext i
    fin_cases i <;> simp [diagonal, square, relation, pair, pow_two]
  have h1 : Steps (pair (x * x * y⁻¹) (x)) 1
      (pair (y⁻¹ * x * x) (x)) :=
    conj0 _ _ (x⁻¹ * x⁻¹) _ (by group; simp only [zpow_ofNat, pow_two, mul_assoc])
  have h2 : Steps (pair (y⁻¹ * x * x) (x)) 3
      (pair (y⁻¹ * x) (x)) :=
    neg0 _ _ _ (by group)
  have h3 : Steps (pair (y⁻¹ * x) (x)) 3
      (pair (y⁻¹) (x)) :=
    neg0 _ _ _ (by group)
  have h4 : Steps (pair (y⁻¹) (x)) 1
      (pair (y) (x)) :=
    inv0 _ _ _ (by group)
  have h5 : Steps (pair (y) (x)) 1
      (pair (y * x) (x)) :=
    mul0 _ _ _ (by group)
  have h6 : Steps (pair (y * x) (x)) 1
      (pair (x⁻¹ * y⁻¹) (x)) :=
    inv0 _ _ _ (by group)
  have h7 : Steps (pair (x⁻¹ * y⁻¹) (x)) 1
      (pair (x⁻¹ * y⁻¹) (y⁻¹)) :=
    mul1 _ _ _ (by group)
  have h8 : Steps (pair (x⁻¹ * y⁻¹) (y⁻¹)) 1
      (pair (y * x) (y⁻¹)) :=
    inv0 _ _ _ (by group)
  have h9 : Steps (pair (y * x) (y⁻¹)) 1
      (pair (x * y) (y⁻¹)) :=
    conj0 _ _ (y⁻¹) _ (by group)
  have h10 : Steps (pair (x * y) (y⁻¹)) 1
      (pair (x) (y⁻¹)) :=
    mul0 _ _ _ (by group)
  have h11 : Steps (pair (x) (y⁻¹)) 1
      (pair (x) (y)) :=
    inv1 _ _ _ (by group)
  have he : standard 2 = pair (x) (y) := by
    ext i
    fin_cases i <;> simp [pair, standard, x, y]
  rw [hi, he]
  exact ((((((((((h1.trans h2).trans h3).trans h4).trans h5).trans h6).trans h7).trans h8).trans h9).trans h10).trans h11)

/-- The recurrence gives a linear bound in the official mathematical primitives. -/
theorem counted (s : ℕ) : Steps (diagonal s) (71 * s + 15) (standard 2) := by
  induction s with
  | zero => simpa using base
  | succ s ih =>
    have hd : Steps (diagonal ((s + 1 : ℕ) : ℤ)) 71 (diagonal s) := by
      simpa using descent ((s : ℤ) + 1)
    convert hd.trans ih using 1
    omega

theorem solvable (s : ℕ) : Reachable (diagonal s) (standard 2) := (counted s).reachable

