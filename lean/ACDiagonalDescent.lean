def generalSquare (p s : ℤ) : Relators 2 := pair (square s (s + 1)) (relation p s)

def normalForm (p s : ℤ) : Relators 2 :=
  pair (y ^ (-p) * x⁻¹ * y ^ p * x⁻¹ * y ^ s * x)
