/-- The image basis is solved by charged ordinary moves. -/
theorem entryMap_standard (p s : ℤ) :
    Reachable (applyHom (entryMap p s) (standard 2)) (standard 2) := by
  let r : Word 2 := y ^ (s + 1 - p) * x⁻¹ * y ^ p
  have hi : applyHom (entryMap p s) (standard 2) = pair r y⁻¹ := by
    ext i
    fin_cases i <;> simp [applyHom, standard, entryMap, pair, r, x, y]
  have h₁ : Steps (pair r y⁻¹) 1 (pair (x⁻¹ * y ^ (s + 1)) y⁻¹) :=
    conj0 _ _ (y ^ (p - s - 1)) _ (by dsimp [r]; group)
  have h₂ : Reachable (pair (x⁻¹ * y ^ (s + 1)) y⁻¹) (pair x⁻¹ y⁻¹) := by
    have h := (mulRight_zpow (pair (x⁻¹ * y ^ (s + 1)) y⁻¹) 0 1 (by decide) (s + 1)).reachable
    have he : (x⁻¹ * y ^ (s + 1)) * (y⁻¹) ^ (s + 1) = x⁻¹ := by group
    simpa only [pair_zero, pair_one, pair_update_zero, he] using h
  have h₃ := (inv0 x⁻¹ y⁻¹ x (by group)).reachable
  have h₄ := (inv1 x y⁻¹ y (by group)).reachable
  have he : pair x y = standard 2 := by ext i; fin_cases i <;> rfl
  rw [hi]
  simpa only [he] using h₁.reachable.trans (h₂.trans (h₃.trans h₄))

/-- The entire square-family problem reduces to the root-conjugacy family.
The image basis is explicitly restored, so generator changes are not free moves. -/
theorem square_of_root (p s : ℤ)
    (h : Reachable (pair (root p) (companion s)) (standard 2)) :
    Reachable (Diagonal.generalSquare p s) (standard 2) :=
  (Diagonal.general_normal_form p s).reachable.trans ((root_entry p s).reachable.trans
    (solvable_hom (entryMap p s) _ h (entryMap_standard p s)))

/-- The entire p=2 positive-sign square slice is ordinarily AC-solvable. -/
theorem square_p2_solvable (s : ℕ) :
    Reachable (Diagonal.generalSquare 2 s) (standard 2) :=
  (Diagonal.general_normal_form 2 s).reachable.trans ((root_entry 2 s).reachable.trans
    (solvable_hom (entryMap 2 s) _ (root_solvable s) (entryMap_standard 2 s)))

