import ACSquareP2Root

/-! Exact ordinary entry into the root family for every integer p,s.
The degree-two root family is solved in the imported module. Generated by
research/p2-family/generate_entry.py; Lean checks every free-group identity. -/

namespace AC.MillerSchupp.SquareFamily.P2
open AC.Certificate AC.WordTransport

def entryMap (p s : ℤ) : Word 2 →* Word 2 :=
  FreeGroup.lift (pair (y ^ (s + 1 - p) * x⁻¹ * y ^ p) y⁻¹)

@[simp] theorem entryMap_x (p s : ℤ) :
    entryMap p s x = y ^ (s + 1 - p) * x⁻¹ * y ^ p := by
  simp [entryMap, x, pair]

@[simp] theorem entryMap_y (p s : ℤ) : entryMap p s y = y⁻¹ := by
  simp [entryMap, y, pair]

private theorem conj0 (r q g z : Word 2)
    (he : g * r * g⁻¹ = z) : Steps (pair r q) 1 (pair z q) := by
  simpa only [pair_zero, pair_one, he, pair_update_zero] using
    Steps.single (Step.conj (pair r q) 0 g)

private theorem conj1 (r q g z : Word 2)
    (he : g * q * g⁻¹ = z) : Steps (pair r q) 1 (pair r z) := by
  simpa only [pair_zero, pair_one, he, pair_update_one] using
    Steps.single (Step.conj (pair r q) 1 g)

private theorem inv0 (r q z : Word 2)
    (he : r⁻¹ = z) : Steps (pair r q) 1 (pair z q) := by
  simpa only [pair_zero, pair_one, he, pair_update_zero] using
    Steps.single (Step.inv (pair r q) 0)

private theorem inv1 (r q z : Word 2)
    (he : q⁻¹ = z) : Steps (pair r q) 1 (pair r z) := by
  simpa only [pair_zero, pair_one, he, pair_update_one] using
    Steps.single (Step.inv (pair r q) 1)

private theorem mul0 (r q z : Word 2)
    (he : r * q = z) : Steps (pair r q) 1 (pair z q) := by
  simpa only [pair_zero, pair_one, he, pair_update_zero] using
    Steps.single (Step.mulRight (pair r q) 0 1 (by decide))

private theorem mul1 (r q z : Word 2)
    (he : q * r = z) : Steps (pair r q) 1 (pair r z) := by
  simpa only [pair_zero, pair_one, he, pair_update_one] using
